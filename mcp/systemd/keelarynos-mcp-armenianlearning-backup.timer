# Operator-approved native timer; install/enable only with explicit authorization.
# Calls the MCP-owned deterministic backup worker, not a ChatGPT task.
[Unit]
Description=Keelaryn MCP ArmenianLearning daily backup (AI-independent)

[Timer]
OnCalendar=daily
Persistent=true
RandomizedDelaySec=10min
AccuracySec=5min
Unit=keelarynos-mcp-armenianlearning-backup.service

[Install]
WantedBy=timers.target
