{
  "schema": "keelaryn.repository-governance.v1",
  "revision": 4,
  "repository": "efremov-aleksei-96/keelaryn",
  "default_branch": "main",
  "merge_policy": {
    "allow_squash_merge": true,
    "allow_merge_commit": false,
    "allow_rebase_merge": false,
    "allow_auto_merge": false
  },
  "branch_hygiene": {
    "delete_branch_on_merge": true,
    "cleanup_at_cycle_close": true,
    "preserve_unique_qualification_refs": true,
    "preserved_prefixes": [
      "candidate-manager-",
      "framework-",
      "gate-framework-",
      "manager-",
      "release-manager-"
    ],
    "policy": "Delete merged service/development branches and fully absorbed temporary branches after each coherent cycle. Never delete the sole Git ref that preserves candidate, gate, framework, Manager-release, or qualification provenance. Never rewrite main or published release history for cleanup."
  },
  "main_ruleset": {
    "name": "Keelaryn main governance",
    "target": "branch",
    "enforcement": "active",
    "include_refs": [
      "refs/heads/main"
    ],
    "bypass_actors": [],
    "required_rules": {
      "pull_request": {
        "required_approving_review_count": 0,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "dismiss_stale_reviews_on_push": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "squash"
        ]
      },
      "required_status_checks": {
        "strict_required_status_checks_policy": true,
        "contexts": [
          "source-gate",
          "repository-governance",
          "release-policy"
        ]
      },
      "non_fast_forward": true,
      "deletion": true
    }
  },
  "workflow_permissions": {
    "default": "contents: read",
    "publication_exception": ".github/workflows/public-release.yml publish job: contents: write"
  },
  "actions_policy": {
    "enabled": true,
    "allowed_actions": "selected",
    "sha_pinning_required": true,
    "selected_actions": {
      "github_owned_allowed": false,
      "verified_allowed": false,
      "patterns_allowed": [
        "actions/checkout@*",
        "actions/upload-artifact@*",
        "actions/download-artifact@*"
      ]
    },
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false,
    "dependabot_github_actions_updates": true,
    "runner_labels": {
      "allowed": [
        "windows-2025",
        "ubuntu-24.04"
      ],
      "moving_latest_forbidden": true,
      "policy": "Use explicit GA OS-family labels for GitHub-hosted runners. Image patch/build revisions may still advance within the pinned OS family."
    }
  },
  "release_policy": {
    "manager_release_publication_requires": [
      "production Full Gate PASS",
      "production Doctor PASS",
      "production UX smoke PASS",
      "exact Full-Gate-tested UPDATE SHA-256",
      "native GitHub immutable release for every non-legacy tag",
      "valid GitHub release attestation for every non-legacy tag"
    ],
    "conditional_pr_gate": {
      "required_context": "release-policy",
      "dependency_context": "distribution-gate",
      "behavior": "Every PR gets release-policy. Non-release diffs pass immediately; release-critical diffs require distribution-gate success on the exact PR head SHA."
    },
    "immutable_releases": {
      "repository_setting_required": true,
      "future_releases_must_be_immutable": true,
      "release_attestation_required": true,
      "verify_each_asset_attestation": true,
      "legacy_mutable_tags": [
        "v4.13.1"
      ],
      "legacy_policy": "Legacy mutable tags are historical exceptions only. They must already exist and remain byte-identical; the publisher must never create a new mutable legacy release."
    }
  }
}
