{
  "schema": "keelaryn.manager-entry-reachability.v2",
  "purpose": "Executable cross-product proof that critical actions remain reachable or fail closed from real Manager process entry under degraded multi-Hub states. The matrix exists because function-local correctness did not prevent MGR-DEF-0023, MGR-DEF-0024, MGR-DEF-0026 and MGR-DEF-0030.",
  "states": [
    {"id":"REGISTRY_ACTIVE_METADATA_INVALID","fixture":"active_metadata_invalid","description":"instances.json is valid but active_instance.json is malformed/unresolved."},
    {"id":"REGISTRY_ACTIVE_HUB_MISSING","fixture":"active_hub_missing","description":"Registry and active selection resolve but the selected Hub directory is missing."},
    {"id":"REGISTRY_ACTIVE_HUB_CORRUPT","fixture":"active_hub_corrupt","description":"Registry and active selection resolve but the selected Hub fails structural validation."},
    {"id":"REGISTRY_ACTIVE_CURRENT_MISSING","fixture":"active_current_missing","description":"Registry, active selection and active Hub are structurally valid, but both per-instance and compatibility CURRENT checkpoints for the old active context are missing."},
    {"id":"REGISTRY_ACTIVE_CURRENT_CORRUPT","fixture":"active_current_corrupt","description":"Registry, active selection and active Hub are structurally valid, but both old-active CURRENT checkpoints are unreadable/corrupt."}
  ],
  "actions": [
    {"id":"ListInstances","class":"diagnostic_recovery","expected_mode":"list_success","invariants":["MH-REGISTRY-001","MH-RECOVERY-001"]},
    {"id":"SwitchInstance","class":"target_driven_recovery","expected_mode":"target_success","invariants":["MH-RECOVERY-001","MH-SWITCH-001","MH-COMMIT-001"]},
    {"id":"BindInstance","class":"target_driven_recovery","expected_mode":"target_success","invariants":["MH-RECOVERY-001","MH-REBIND-001","MH-BINDING-001"]},
    {"id":"UpdateManager","class":"manager_global","expected_mode":"global_success","invariants":["MH-MANAGER-GLOBAL-001","MH-RECOVERY-001"]},
    {"id":"BuildDistribution","class":"manager_global","expected_mode":"global_success","invariants":["MH-MANAGER-GLOBAL-001","MH-RECOVERY-001"]},
    {"id":"BuildRelease","class":"manager_global","expected_mode":"global_success","invariants":["MH-MANAGER-GLOBAL-001","MH-RECOVERY-001"]},
    {"id":"BuildAIContext","class":"manager_global","expected_mode":"global_success","invariants":["MH-MANAGER-GLOBAL-001","MH-RECOVERY-001"]},
    {"id":"Doctor","class":"diagnostic","expected_mode":"diagnostic_reached","invariants":["MH-REGISTRY-001","MH-ISOLATION-001","MH-RECOVERY-001"]},
    {"id":"UpdateHub","class":"hub_bound","expected_mode":"fail_closed","invariants":["MH-CONTEXT-001","MH-ISOLATION-001"]},
    {"id":"UpdateAll","class":"mixed_manager_hub","expected_mode":"fail_closed","invariants":["MH-CONTEXT-001","MH-COMPAT-001","MH-MANAGER-GLOBAL-001"]},
    {"id":"RepairCurrent","class":"active_context_transport_repair","expected_mode":"fail_closed","invariants":["MH-BINDING-001","MH-CONTEXT-001"]},
    {"id":"BuildCandidateTransport","class":"hub_bound","expected_mode":"fail_closed","invariants":["MH-LIFECYCLE-001","MH-CONTEXT-001","MH-BINDING-001"]},
    {"id":"RestoreCandidateTransport","class":"hub_bound","expected_mode":"fail_closed","invariants":["MH-LIFECYCLE-001","MH-CONTEXT-001","MH-BINDING-001"]}
  ],
  "coverage_requirements": [
    {
      "id":"CR-ALL-DEGRADED-ENTRY",
      "states":["REGISTRY_ACTIVE_METADATA_INVALID","REGISTRY_ACTIVE_HUB_MISSING","REGISTRY_ACTIVE_HUB_CORRUPT","REGISTRY_ACTIVE_CURRENT_MISSING","REGISTRY_ACTIVE_CURRENT_CORRUPT"],
      "actions":["ListInstances","SwitchInstance","BindInstance","UpdateManager","BuildDistribution","BuildRelease","BuildAIContext","Doctor","UpdateHub"]
    },
    {
      "id":"CR-CURRENT-DEGRADED-BOUNDARIES",
      "states":["REGISTRY_ACTIVE_CURRENT_MISSING","REGISTRY_ACTIVE_CURRENT_CORRUPT"],
      "actions":["UpdateAll","RepairCurrent","BuildCandidateTransport","RestoreCandidateTransport"]
    }
  ],
  "freeze_rule": "Every pair generated by coverage_requirements must execute through the real Manager process entry on a disposable Windows installation. Any P1/P2 recovery, registry-resolution, context-routing or compatibility-shadow surface with only static/function-level proof is a release blocker. A scenario harness may not restore state through the same runtime path under test and must publish a result record even when setup or cleanup fails."
}
