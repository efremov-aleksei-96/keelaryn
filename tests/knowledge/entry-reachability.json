{
  "schema": "keelaryn.manager-entry-reachability.v1",
  "purpose": "Executable proof that critical actions remain reachable or fail closed from real Manager process entry under degraded multi-Hub states. This model exists because function-local correctness did not prevent MGR-DEF-0023, MGR-DEF-0024, MGR-DEF-0026 and MGR-DEF-0030.",
  "states": [
    {"id":"REGISTRY_ACTIVE_METADATA_INVALID","description":"instances.json is valid but active_instance.json is missing, malformed or unresolved."},
    {"id":"REGISTRY_ACTIVE_HUB_MISSING","description":"Registry and active selection resolve but the selected Hub directory is missing."},
    {"id":"REGISTRY_ACTIVE_HUB_CORRUPT","description":"Registry and active selection resolve but the selected Hub fails structural/identity validation."},
    {"id":"REGISTRY_ACTIVE_CURRENT_MISSING","description":"Registry, active selection and active Hub are structurally valid, but both per-instance and compatibility CURRENT checkpoints required for the old active context are missing."},
    {"id":"REGISTRY_ACTIVE_CURRENT_CORRUPT","description":"Registry, active selection and active Hub are structurally valid, but the old active CURRENT/compatibility checkpoint is unreadable, mismatched or otherwise ineligible."}
  ],
  "actions": [
    {"id":"ListInstances","class":"diagnostic_recovery","expected":"reachable_without_old_active_shadow","invariants":["MH-REGISTRY-001","MH-RECOVERY-001"]},
    {"id":"SwitchInstance","class":"target_driven_recovery","expected":"reachable_without_old_active_shadow_and_validate_requested_target","invariants":["MH-RECOVERY-001","MH-SWITCH-001","MH-COMMIT-001"]},
    {"id":"BindInstance","class":"target_driven_recovery","expected":"reachable_without_old_active_shadow_and_validate_requested_target","invariants":["MH-RECOVERY-001","MH-REBIND-001","MH-BINDING-001"]},
    {"id":"RepairCurrent","class":"active_context_transport_repair","expected":"fail_closed_without_Hub_mutation_when_CURRENT_is_missing_or_unreadable; this command sanitizes an existing CURRENT and does not reconstruct a missing checkpoint","invariants":["MH-BINDING-001","MH-CONTEXT-001"]},
    {"id":"UpdateManager","class":"manager_global","expected":"reachable_without_active_Hub_or_CURRENT_health_and_must_not_process_Hub_inputs","invariants":["MH-MANAGER-GLOBAL-001","MH-RECOVERY-001"]},
    {"id":"BuildDistribution","class":"manager_global","expected":"reachable_without_active_Hub_or_CURRENT_health","invariants":["MH-MANAGER-GLOBAL-001","MH-RECOVERY-001"]},
    {"id":"BuildRelease","class":"manager_global","expected":"reachable_without_active_Hub_or_CURRENT_health","invariants":["MH-MANAGER-GLOBAL-001","MH-RECOVERY-001"]},
    {"id":"BuildAIContext","class":"manager_global","expected":"reachable_without_active_Hub_or_CURRENT_health","invariants":["MH-MANAGER-GLOBAL-001","MH-RECOVERY-001"]},
    {"id":"Doctor","class":"diagnostic","expected":"reachable_and_diagnostic_without_mutating_degraded_state","invariants":["MH-REGISTRY-001","MH-ISOLATION-001","MH-RECOVERY-001"]},
    {"id":"UpdateHub","class":"hub_bound","expected":"fail_closed_before_Hub_mutation_when_active_context_cannot_be_safely_resolved","invariants":["MH-CONTEXT-001","MH-ISOLATION-001"]},
    {"id":"UpdateAll","class":"hub_bound","expected":"preserve_global_Manager_semantics_but_fail_closed_for_Hub_intent_without_captured_safe_context","invariants":["MH-CONTEXT-001","MH-COMPAT-001","MH-MANAGER-GLOBAL-001"]},
    {"id":"BuildCandidateTransport","class":"hub_bound","expected":"fail_closed_when_active_instance_CURRENT_is_unavailable_or_unbound","invariants":["MH-LIFECYCLE-001","MH-CONTEXT-001","MH-BINDING-001"]},
    {"id":"RestoreCandidateTransport","class":"hub_bound","expected":"fail_closed_when_active_instance_context_is_unavailable_or_unbound","invariants":["MH-LIFECYCLE-001","MH-CONTEXT-001","MH-BINDING-001"]}
  ],
  "mandatory_process_entry_scenarios": [
    {"id":"ER-001","state":"REGISTRY_ACTIVE_CURRENT_MISSING","action":"ListInstances","expected":"success"},
    {"id":"ER-002","state":"REGISTRY_ACTIVE_CURRENT_MISSING","action":"SwitchInstance","expected":"success_to_healthy_requested_target"},
    {"id":"ER-003","state":"REGISTRY_ACTIVE_CURRENT_MISSING","action":"BindInstance","expected":"success_to_healthy_requested_target"},
    {"id":"ER-004","state":"REGISTRY_ACTIVE_CURRENT_MISSING","action":"UpdateManager","expected":"success_or_clean_no_update_without_Hub_processing"},
    {"id":"ER-005","state":"REGISTRY_ACTIVE_CURRENT_MISSING","action":"BuildDistribution","expected":"success"},
    {"id":"ER-006","state":"REGISTRY_ACTIVE_CURRENT_MISSING","action":"RepairCurrent","expected":"fail_closed_without_Hub_mutation"},
    {"id":"ER-007","state":"REGISTRY_ACTIVE_CURRENT_MISSING","action":"UpdateHub","expected":"fail_closed_without_Hub_mutation"},
    {"id":"ER-008","state":"REGISTRY_ACTIVE_CURRENT_MISSING","action":"BuildCandidateTransport","expected":"fail_closed_without_cross_instance_fallback"},
    {"id":"ER-009","state":"REGISTRY_ACTIVE_METADATA_INVALID","action":"ListInstances","expected":"success"},
    {"id":"ER-010","state":"REGISTRY_ACTIVE_METADATA_INVALID","action":"SwitchInstance","expected":"success_to_healthy_requested_target"},
    {"id":"ER-011","state":"REGISTRY_ACTIVE_CURRENT_CORRUPT","action":"ListInstances","expected":"success"},
    {"id":"ER-012","state":"REGISTRY_ACTIVE_CURRENT_CORRUPT","action":"SwitchInstance","expected":"success_to_healthy_requested_target"}
  ],
  "freeze_rule": "Any P1/P2 recovery, registry-resolution, context-routing or compatibility-shadow surface must have at least one real process-entry executable scenario for every degraded state the action claims to recover. Static/function-level-only proof is a release blocker."
}
