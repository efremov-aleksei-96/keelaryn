     $stdout=Join-Path $commandLogRoot ($prefix+'.stdout.txt')
     $stderr=Join-Path $commandLogRoot ($prefix+'.stderr.txt')
     $specPath=Join-Path $commandLogRoot ($prefix+'.spec.json')
