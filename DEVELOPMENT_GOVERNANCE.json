{
  "schema": "keelaryn.development-governance.v1",
  "revision": 2,
  "repository": "efremov-aleksei-96/keelaryn",
  "development_branches": {
    "pattern": "dev/**",
    "qualification_state": "unqualified",
    "push_before_qualification_allowed": true,
    "direct_merge_to_main_forbidden": true,
    "candidate_freeze_requires_clean_branch": true,
    "policy": "Development branches are explicitly non-release workspaces. They may contain failing or incomplete commits and may be pushed before qualification. They must never be described as candidate, approved, production-ready, or release-qualified solely because remote development validation passes."
  },
  "ci": {
    "workflow": ".github/workflows/development-validation.yml",
    "runner": "windows-2025",
    "token_permissions": "contents: read",
    "cancel_obsolete_runs": true,
    "artifact_retention_days": 3,
    "upload_disposable_worktrees": false,
    "publish_release_assets": false,
    "validation": [
      "PowerShell parser",
      "Manager SelfTest",
      "frontend SelfTest",
      "deterministic BuildRelease x2"
    ]
  },
  "resource_budget": {
    "repository_target_mib": 100,
    "repository_warning_mib": 250,
    "tracked_file_target_mib": 1,
    "tracked_file_warning_mib": 5,
    "tracked_file_policy_max_mib": 50,
    "active_branch_target": 50,
    "development_artifact_retention_days": 3,
    "cache_target_mib": 1024,
    "commit_generated_release_archives": false,
    "upload_tests_work": false,
    "upload_duplicate_build_artifacts": false
  },
  "critical_model_escalation": {
    "enabled": true,
    "protocol": "ASTRA_ESCALATION.md",
    "default_engineering_model": "GPT-5.6 Sol",
    "preferred_scarce_reviewer": "GPT-6 Astra",
    "availability_contract": "plus_limited_manual",
    "automatic_invocation": false,
    "max_reviews_per_critical_point": 1,
    "allowed_triggers": [
      "final_prefreeze_adversarial_review",
      "evidence_reality_contradiction",
      "two_evidence_backed_iterations_without_classification",
      "high_consequence_proof_quality_question",
      "repeated_late_escape_pattern"
    ],
    "forbidden_uses": [
      "actions_polling",
      "routine_log_reading",
      "ordinary_code_generation",
      "mechanical_metadata_sync",
      "known_harness_only_fix",
      "known_environment_retry",
      "repeating_conclusive_test"
    ],
    "review_packet_required": true,
    "review_is_qualification": false,
    "clean_review_can_replace_required_gates": false,
    "policy": "Scarce high-capability review is a bounded manual escalation, not a default execution model. Prefer one consolidated exact-head adversarial review at a genuine critical point; return implementation, CI iteration and ordinary follow-up to the default engineering model."
  },
  "promotion": {
    "development_validation_is_production_qualification": false,
    "pull_request_to_main_required": true,
    "existing_main_required_checks_remain_authoritative": true,
    "production_release_boundary_unchanged": true,
    "policy": "A development branch may be iterated remotely until stable. Promotion to a candidate or main requires the ordinary Keelaryn qualification/release discipline, including the existing source, disposable/full-gate, production and provenance boundaries applicable to that change."
  }
}
