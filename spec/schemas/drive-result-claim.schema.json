{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:drive-result-claim:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "project_id",
    "result_id",
    "base_canonical_epoch",
    "claim_plan_id",
    "claim_plan_sha256",
    "claim_plan_size",
    "source",
    "claimed"
  ],
  "properties": {
    "schema": { "const": "keelaryn.drive-result-claim.v1" },
    "state": { "const": "CLAIMED" },
    "project_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "result_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "base_canonical_epoch": { "type": "integer", "minimum": 0 },
    "claim_plan_id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "claim_plan_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "claim_plan_size": { "type": "integer", "minimum": 0 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folder_id", "result_markdown_id", "result_marker_id", "result_markdown", "result_marker"],
      "properties": {
        "folder_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "result_markdown_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "result_marker_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "result_markdown": { "$ref": "common.schema.json#/$defs/presentState" },
        "result_marker": { "$ref": "common.schema.json#/$defs/presentState" }
      }
    },
    "claimed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["folder_id", "result_markdown_id", "result_marker_id", "result_markdown", "result_marker"],
      "properties": {
        "folder_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "result_markdown_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "result_marker_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "result_markdown": { "$ref": "common.schema.json#/$defs/presentState" },
        "result_marker": { "$ref": "common.schema.json#/$defs/presentState" }
      }
    }
  }
}
