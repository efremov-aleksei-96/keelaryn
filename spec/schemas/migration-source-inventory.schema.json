{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:migration-source-inventory:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "entries"],
  "properties": {
    "schema": { "const": "keelaryn.migration-source-inventory.v1" },
    "candidate_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "size", "sha256", "selectable"],
        "properties": {
          "source": { "$ref": "common.schema.json#/$defs/relativePath" },
          "size": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
          "sha256": {
            "oneOf": [
              { "$ref": "common.schema.json#/$defs/sha256" },
              { "type": "null" }
            ]
          },
          "selectable": { "type": "boolean" }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "size": { "maximum": 134217728 }
              },
              "required": ["size"]
            },
            "then": {
              "properties": {
                "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
                "selectable": { "const": true }
              }
            },
            "else": {
              "properties": {
                "sha256": { "type": "null" },
                "selectable": { "const": false }
              }
            }
          }
        ]
      }
    }
  }
}
