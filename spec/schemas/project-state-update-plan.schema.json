{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:project-state-update-plan:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "project_id", "update_id", "project_folder_id", "update_folder_id", "plan_file_id", "old", "new", "done_marker_id"],
  "properties": {
    "schema": { "const": "keelaryn.project-state-update-plan.v1" },
    "state": { "const": "PREPARED" },
    "project_id": { "$ref": "common.schema.json#/$defs/projectId" },
    "update_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "project_folder_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
    "update_folder_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
    "plan_file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
    "old": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "fingerprint"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/presentState" }
      }
    },
    "new": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "fingerprint"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/presentState" }
      }
    },
    "done_marker_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" }
  }
}
