{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:control:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change_id", "change_sha256", "base_canonical_epoch"],
  "properties": {
    "schema": { "const": "keelaryn.control.v1" },
    "change_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "change_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "base_canonical_epoch": { "type": "integer", "minimum": 0 }
  }
}
