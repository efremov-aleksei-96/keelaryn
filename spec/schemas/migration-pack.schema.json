{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:migration-pack:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "source_manifest",
    "mapping_manifest",
    "canonical_outputs",
    "root_index",
    "source_file_count",
    "source_total_bytes",
    "canonical_file_count",
    "canonical_total_bytes"
  ],
  "properties": {
    "schema": { "const": "keelaryn.migration-pack.v1" },
    "candidate_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "const": "authority/MIGRATION_SOURCE.json" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      }
    },
    "mapping_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "const": "authority/MIGRATION_MAPPING.json" },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 0, "maximum": 16777216 }
      }
    },
    "canonical_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operation_id",
          "target",
          "semantic_sources",
          "payload",
          "sha256",
          "size"
        ],
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^canonical-[0-9]{5}$"
          },
          "target": { "$ref": "common.schema.json#/$defs/relativePath" },
          "semantic_sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/relativePath" }
          },
          "payload": {
            "type": "string",
            "pattern": "^canonical/canonical-[0-9]{5}\\.bin$"
          },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0, "maximum": 134217728 }
        }
      }
    },
    "root_index": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_sources", "payload", "sha256", "size"],
          "properties": {
            "semantic_sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/relativePath" }
            },
            "payload": { "const": "root/INDEX.md" },
            "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
            "size": { "type": "integer", "minimum": 0, "maximum": 134217728 }
          }
        }
      ]
    },
    "source_file_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "source_total_bytes": { "type": "integer", "minimum": 0, "maximum": 2147483648 },
    "canonical_file_count": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "canonical_total_bytes": { "type": "integer", "minimum": 0, "maximum": 2147483648 }
  }
}
