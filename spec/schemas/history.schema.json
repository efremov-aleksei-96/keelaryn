{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:history:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "change_id",
    "change_sha256",
    "base_canonical_epoch",
    "entries"
  ],
  "properties": {
    "schema": { "const": "keelaryn.history.v1" },
    "status": { "const": "VERIFIED" },
    "change_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "change_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "base_canonical_epoch": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation_id", "kind", "target", "old", "new", "snapshot_path"],
            "properties": {
              "operation_id": { "$ref": "common.schema.json#/$defs/operationId" },
              "kind": { "const": "ADD" },
              "target": { "$ref": "common.schema.json#/$defs/relativePath" },
              "old": { "$ref": "common.schema.json#/$defs/absentState" },
              "new": { "$ref": "common.schema.json#/$defs/presentState" },
              "snapshot_path": { "type": "null" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation_id", "kind", "target", "old", "new", "snapshot_path"],
            "properties": {
              "operation_id": { "$ref": "common.schema.json#/$defs/operationId" },
              "kind": { "const": "REPLACE" },
              "target": { "$ref": "common.schema.json#/$defs/relativePath" },
              "old": { "$ref": "common.schema.json#/$defs/presentState" },
              "new": { "$ref": "common.schema.json#/$defs/presentState" },
              "snapshot_path": { "$ref": "common.schema.json#/$defs/relativePath" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation_id", "kind", "target", "old", "new", "snapshot_path"],
            "properties": {
              "operation_id": { "$ref": "common.schema.json#/$defs/operationId" },
              "kind": { "const": "DELETE" },
              "target": { "$ref": "common.schema.json#/$defs/relativePath" },
              "old": { "$ref": "common.schema.json#/$defs/presentState" },
              "new": { "$ref": "common.schema.json#/$defs/absentState" },
              "snapshot_path": { "$ref": "common.schema.json#/$defs/relativePath" }
            }
          }
        ]
      }
    }
  }
}
