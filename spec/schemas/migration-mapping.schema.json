{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:migration-mapping:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_id",
    "source_manifest_sha256",
    "source_actions",
    "canonical_outputs",
    "root_index"
  ],
  "properties": {
    "schema": { "const": "keelaryn.migration-mapping.v1" },
    "candidate_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "source_manifest_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "source_actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "classification"],
            "properties": {
              "source": { "$ref": "common.schema.json#/$defs/relativePath" },
              "classification": {
                "enum": ["CANONICAL_IMPORT", "ROUTER_SOURCE", "DROP_TECHNICAL"]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "classification", "destination"],
            "properties": {
              "source": { "$ref": "common.schema.json#/$defs/relativePath" },
              "classification": {
                "enum": ["PROJECT_WORK_IMPORT", "ARCHIVE_ONLY"]
              },
              "destination": { "$ref": "common.schema.json#/$defs/relativePath" }
            }
          }
        ]
      }
    },
    "project_initial_states": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project_id", "prepared_path"],
        "properties": {
          "project_id": { "$ref": "common.schema.json#/$defs/changeId" },
          "prepared_path": { "$ref": "common.schema.json#/$defs/relativePath" }
        }
      }
    },
    "canonical_outputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target", "semantic_sources", "payload"],
        "properties": {
          "target": { "$ref": "common.schema.json#/$defs/relativePath" },
          "semantic_sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true,
            "items": { "$ref": "common.schema.json#/$defs/relativePath" }
          },
          "payload": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "source"],
                "properties": {
                  "kind": { "const": "SOURCE" },
                  "source": { "$ref": "common.schema.json#/$defs/relativePath" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "prepared_path"],
                "properties": {
                  "kind": { "const": "PREPARED" },
                  "prepared_path": { "$ref": "common.schema.json#/$defs/relativePath" }
                }
              }
            ]
          }
        }
      }
    },
    "root_index": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["semantic_sources", "prepared_path"],
          "properties": {
            "semantic_sources": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/relativePath" }
            },
            "prepared_path": { "$ref": "common.schema.json#/$defs/relativePath" }
          }
        }
      ]
    }
  }
}
