{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:migration-source:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "entries"],
  "properties": {
    "schema": { "const": "keelaryn.migration-source.v1" },
    "candidate_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "sha256", "size"],
        "properties": {
          "source": { "$ref": "common.schema.json#/$defs/relativePath" },
          "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
          "size": { "type": "integer", "minimum": 0, "maximum": 134217728 }
        }
      }
    }
  }
}
