{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:work-state-update-plan:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "owner_kind", "owner_id", "owner_folder_id", "update_id", "update_folder_id", "plan_file_id", "old", "new", "done_marker_id"],
  "properties": {
    "schema": { "const": "keelaryn.work-state-update-plan.v1" },
    "state": { "const": "PREPARED" },
    "owner_kind": { "enum": ["PROJECT", "RECONCILIATION"] },
    "owner_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "owner_folder_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
    "update_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "update_folder_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
    "plan_file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
    "old": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "fingerprint"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/presentState" }
      }
    },
    "new": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "fingerprint"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/presentState" }
      }
    },
    "done_marker_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" }
  }
}
