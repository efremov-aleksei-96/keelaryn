{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:change:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change_id", "base_canonical_epoch", "operations"],
  "properties": {
    "schema": { "const": "keelaryn.change.v1" },
    "change_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "base_canonical_epoch": { "type": "integer", "minimum": 0 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation_id", "kind", "target", "old", "new", "prepared_path"],
            "properties": {
              "operation_id": { "$ref": "common.schema.json#/$defs/operationId" },
              "kind": { "const": "ADD" },
              "target": { "$ref": "common.schema.json#/$defs/relativePath" },
              "old": { "$ref": "common.schema.json#/$defs/absentState" },
              "new": { "$ref": "common.schema.json#/$defs/presentState" },
              "prepared_path": { "$ref": "common.schema.json#/$defs/relativePath" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation_id", "kind", "target", "old", "new", "prepared_path"],
            "properties": {
              "operation_id": { "$ref": "common.schema.json#/$defs/operationId" },
              "kind": { "const": "REPLACE" },
              "target": { "$ref": "common.schema.json#/$defs/relativePath" },
              "old": { "$ref": "common.schema.json#/$defs/presentState" },
              "new": { "$ref": "common.schema.json#/$defs/presentState" },
              "prepared_path": { "$ref": "common.schema.json#/$defs/relativePath" }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["operation_id", "kind", "target", "old", "new"],
            "properties": {
              "operation_id": { "$ref": "common.schema.json#/$defs/operationId" },
              "kind": { "const": "DELETE" },
              "target": { "$ref": "common.schema.json#/$defs/relativePath" },
              "old": { "$ref": "common.schema.json#/$defs/presentState" },
              "new": { "$ref": "common.schema.json#/$defs/absentState" }
            }
          }
        ]
      }
    }
  }
}
