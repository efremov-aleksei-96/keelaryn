{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:migration-selection:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "candidate_id", "sources"],
  "properties": {
    "schema": { "const": "keelaryn.migration-selection.v1" },
    "candidate_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/relativePath" }
    }
  }
}
