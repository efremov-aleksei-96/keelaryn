{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:project-state-update:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "state", "project_id", "update_id", "plan_file_id", "plan_sha256", "plan_size", "old", "new"],
  "properties": {
    "schema": { "const": "keelaryn.project-state-update.v1" },
    "state": { "const": "APPLIED" },
    "project_id": { "$ref": "common.schema.json#/$defs/projectId" },
    "update_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "plan_file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
    "plan_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "plan_size": { "type": "integer", "minimum": 0 },
    "old": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "fingerprint"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/presentState" }
      }
    },
    "new": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "fingerprint"],
      "properties": {
        "file_id": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._-]+$" },
        "fingerprint": { "$ref": "common.schema.json#/$defs/presentState" }
      }
    }
  }
}
