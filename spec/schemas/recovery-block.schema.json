{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:recovery-block:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change_id",
    "change_sha256",
    "reason",
    "operation_id",
    "target",
    "observed",
    "message"
  ],
  "properties": {
    "schema": { "const": "keelaryn.recovery-block.v1" },
    "change_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "change_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "reason": {
      "enum": [
        "TARGET_UNKNOWN",
        "MASTER_CONTROL_MISMATCH",
        "HISTORY_INVALID",
        "STAGED_INPUT_INVALID",
        "FINAL_STATE_INVALID"
      ]
    },
    "operation_id": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "common.schema.json#/$defs/operationId" }
      ]
    },
    "target": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "common.schema.json#/$defs/relativePath" }
      ]
    },
    "observed": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "common.schema.json#/$defs/fileState" }
      ]
    },
    "message": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
