{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:keelaryn:schema:postcheck:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change_id",
    "change_sha256",
    "base_canonical_epoch",
    "decision",
    "reason"
  ],
  "properties": {
    "schema": { "const": "keelaryn.postcheck.v1" },
    "change_id": { "$ref": "common.schema.json#/$defs/changeId" },
    "change_sha256": { "$ref": "common.schema.json#/$defs/sha256" },
    "base_canonical_epoch": { "type": "integer", "minimum": 0 },
    "decision": { "enum": ["PASS", "FAIL"] },
    "reason": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
