[Unit]
Description=Keelaryn read-only production snapshot for operation %i
After=keelaryn-operation-agent.service keelaryn-operation-transport.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/keelaryn/control-current
Environment=PYTHONPATH=/opt/keelaryn/control-current/core
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -B -m keelaryn_core.production_snapshot --operation-id %i --output /var/lib/keelaryn/operations/%i/production-snapshot.json
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/keelaryn /etc/keelaryn/hub.env /var/lib/keelaryn/deployment /var/lib/keelaryn/mutation-gate
ReadWritePaths=/var/lib/keelaryn/operations/%i
InaccessiblePaths=/etc/keelaryn/drive.env /etc/keelaryn/operation-control /var/lib/keelaryn/migration /var/lib/keelaryn-operation-transport /root /home
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid
