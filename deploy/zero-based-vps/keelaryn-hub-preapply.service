[Unit]
Description=Keelaryn guarded Hub pre-apply worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/keelaryn/control-current
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
ExecStart=/usr/bin/python3 -B /opt/keelaryn/control-current/deploy/zero-based-vps/operation_hub_pre_apply.py
TimeoutStartSec=7200
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/etc/keelaryn/hub.env /var/lib/keelaryn/deployment /var/lib/keelaryn/mutation-gate /var/lib/keelaryn/migration
ReadOnlyPaths=/var/lib/keelaryn/operation-control/hub-pre-apply-profile.json
InaccessiblePaths=/etc/keelaryn/operation-control/github-operations.env /etc/keelaryn/drive.env /root /home
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectProc=invisible
ProcSubset=pid
