[Unit]
Description=Keelaryn durable operation dispatcher
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/keelaryn/current
Environment=PYTHONPATH=/opt/keelaryn/current/core
Environment=PYTHONDONTWRITEBYTECODE=1
StateDirectory=keelaryn/operations keelaryn/operation-control
StateDirectoryMode=0700
UMask=0077
ExecStart=/usr/bin/python3 -B -m keelaryn_core.operation_agent --operation-root /var/lib/keelaryn/operations --control-root /var/lib/keelaryn/operation-control serve --poll-seconds 5
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/keelaryn/operations /var/lib/keelaryn/operation-control
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ProtectProc=invisible
ProcSubset=pid

[Install]
WantedBy=multi-user.target
