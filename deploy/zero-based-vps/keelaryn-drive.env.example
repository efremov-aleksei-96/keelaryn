# Copy to /etc/keelaryn/drive.env on the VPS.
# Store real values only on the VPS. Recommended ownership/mode: root:root 0600.

KEELARYN_HUB_ROOT_ID=REPLACE_WITH_APPROVED_GOOGLE_DRIVE_HUB_ROOT_ID
KEELARYN_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
KEELARYN_GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET
KEELARYN_GOOGLE_REFRESH_TOKEN=REPLACE_WITH_GOOGLE_OAUTH_REFRESH_TOKEN
