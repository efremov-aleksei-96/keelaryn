# Copy to /etc/keelaryn/drive.env on the disposable/test VPS only.
# Set owner root:root and mode 0600. Never commit populated credentials.

KEELARYN_HUB_ROOT_ID=REPLACE_WITH_DISPOSABLE_DRIVE_HUB_ROOT_ID
KEELARYN_GOOGLE_CLIENT_ID=REPLACE_WITH_DISPOSABLE_OAUTH_CLIENT_ID
KEELARYN_GOOGLE_CLIENT_SECRET=REPLACE_WITH_DISPOSABLE_OAUTH_CLIENT_SECRET
KEELARYN_GOOGLE_REFRESH_TOKEN=REPLACE_WITH_DISPOSABLE_OAUTH_REFRESH_TOKEN
